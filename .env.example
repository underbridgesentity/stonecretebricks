# Quote enquiries.
# Without RESEND_API_KEY the enquiry is recorded and printed to the dev
# terminal, so the whole flow is testable locally with no credentials.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM="Stonecrete Bricks <quotes@stonecretebricks.co.za>"

# Inbound email. Receiving is enabled on the domain, so Resend holds its MX and
# every message sent to stonecretebricks.co.za arrives at /api/inbound as a
# signed webhook rather than in a mailbox.
#
# The secret is the signing secret of the Resend webhook pointed at
# https://stonecretebricks.co.za/api/inbound. Without it the route returns 500
# and refuses the message, rather than accepting anything unverified.
INBOUND_WEBHOOK_SECRET=

# Optional. Forwards received mail to a real inbox until there is durable
# storage. It must NOT be an address on stonecretebricks.co.za: Resend holds
# the MX for that domain, so it would loop straight back into the endpoint.
# The route refuses that case rather than creating the loop.
INBOUND_FORWARD_TO=

# Staging only. Lets a build ship while product figures are still flagged
# assumed rather than confirmed. Never set this in production.
PUBLIC_ALLOW_UNCONFIRMED_SPECS=
